# ============================================================
# lawyer-ai-assistant
# Docker / Production Environment Template
#
# 复制：
#
# .env.example
#      ↓
# .env
#
# 然后填写真实 Secret。
#
# .env 绝对不要提交 Git。
# ============================================================


# ============================================================
# DeepSeek
# ============================================================

DEEPSEEK_API_KEY=replace-me

DEEPSEEK_CHAT_MODEL=deepseek-v4-flash


# ============================================================
# JWT
#
# Production 必须 >= 32 bytes。
# ============================================================

SECURITY_JWT_SECRET=replace-me-with-a-secure-secret-at-least-32-bytes

JWT_ISSUER=lawyer-ai-assistant

JWT_ACCESS_TOKEN_TTL=1h


# ============================================================
# MCP
#
# Docker Compose Service Name:
#
# mcp-server
# ============================================================

LEGAL_MCP_SERVER_URL=http://mcp-server:8081

MCP_REQUEST_TIMEOUT=30s


# ============================================================
# Ollama
#
# Docker Compose Service Name:
#
# ollama
# ============================================================

OLLAMA_BASE_URL=http://ollama:11434

OLLAMA_EMBEDDING_MODEL=bge-m3


# ============================================================
# RAG
# ============================================================

LEGAL_KNOWLEDGE_LOCATION=classpath:knowledge/


# ============================================================
# AI Cache
# ============================================================

AI_CACHE_KNOWLEDGE_VERSION=v1


# ============================================================
# MySQL
#
# Day20:
# Infrastructure only.
#
# Day21:
# Java Persistence Integration.
# ============================================================

MYSQL_DATABASE=lawyer_ai
MYSQL_USER=lawyer_ai
MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me

# Docker internal JDBC URL
MYSQL_URL=jdbc:mysql://mysql:3306/lawyer_ai?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai

# =============================================================
# Flyway
# =============================================================

# Only one application container should enable migration.
SPRING_FLYWAY_ENABLED=false

# Optional dedicated migration credentials.
# When omitted, Flyway uses MYSQL_URL / MYSQL_USER / MYSQL_PASSWORD.
# FLYWAY_URL=jdbc:mysql://mysql:3306/lawyer_ai
# FLYWAY_USER=lawyer_ai_migration
# FLYWAY_PASSWORD=replace-me

# =============================================================
# HikariCP
# =============================================================

HIKARI_MINIMUM_IDLE=1
HIKARI_MAXIMUM_POOL_SIZE=5
HIKARI_CONNECTION_TIMEOUT_MS=10000
HIKARI_VALIDATION_TIMEOUT_MS=5000
HIKARI_IDLE_TIMEOUT_MS=600000
HIKARI_MAX_LIFETIME_MS=1800000
HIKARI_INITIALIZATION_FAIL_TIMEOUT_MS=1


# ============================================================
# Redis
#
# Day20:
# Infrastructure only.
#
# Day21:
# Distributed Cache / State integration.
# ============================================================

REDIS_HOST=redis

REDIS_PORT=6379


# ============================================================
# Grafana
# ============================================================

GRAFANA_ADMIN_USER=admin

GRAFANA_ADMIN_PASSWORD=replace-me