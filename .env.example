# ============================================================
# Required production secrets
# ============================================================

DEEPSEEK_API_KEY=replace-me

SECURITY_JWT_SECRET=replace-me-with-at-least-32-bytes

MYSQL_PASSWORD=replace-me
MYSQL_ROOT_PASSWORD=replace-me

GRAFANA_ADMIN_PASSWORD=replace-me

# ============================================================
# Required production infrastructure
# ============================================================

MYSQL_DATABASE=lawyer_ai
MYSQL_USER=lawyer_ai

MYSQL_URL=jdbc:mysql://mysql:3306/lawyer_ai?useUnicode=true&characterEncoding=UTF-8&serverTimezone=Asia/Shanghai&allowPublicKeyRetrieval=true&sslMode=DISABLED

# ============================================================
# Optional model configuration
# ============================================================

DEEPSEEK_CHAT_MODEL=deepseek-v4-flash
OLLAMA_EMBEDDING_MODEL=bge-m3

# ============================================================
# Optional MCP/RAG configuration
# ============================================================

MCP_REQUEST_TIMEOUT=30s
LEGAL_KNOWLEDGE_LOCATION=classpath:knowledge/
LEGAL_KNOWLEDGE_VERSION=v2

# ============================================================
# Optional JWT configuration
# ============================================================

JWT_ISSUER=lawyer-ai-assistant
JWT_ACCESS_TOKEN_TTL=1h

# ============================================================
# Optional dedicated Flyway credentials
# ============================================================

# FLYWAY_URL=jdbc:mysql://mysql:3306/lawyer_ai
# FLYWAY_USER=lawyer_ai_migration
# FLYWAY_PASSWORD=replace-me

# ============================================================
# Optional HikariCP configuration
# ============================================================

HIKARI_POOL_NAME=lawyer-ai-mysql-pool
HIKARI_MINIMUM_IDLE=1
HIKARI_MAXIMUM_POOL_SIZE=5
HIKARI_CONNECTION_TIMEOUT_MS=10000
HIKARI_VALIDATION_TIMEOUT_MS=5000
HIKARI_IDLE_TIMEOUT_MS=600000
HIKARI_MAX_LIFETIME_MS=1800000
HIKARI_INITIALIZATION_FAIL_TIMEOUT_MS=1

# ============================================================
# Optional Redis/Cache configuration
#
# REDIS_HOST and REDIS_PORT are fixed by Compose.
# ============================================================

REDIS_DATABASE=0
REDIS_PASSWORD=

AI_CACHE_BACKEND=REDIS
AI_CACHE_REDIS_KEY_PREFIX=lawyer-ai
AI_CACHE_REDIS_FAIL_OPEN=true

# ============================================================
# Optional Grafana configuration
# ============================================================

GRAFANA_ADMIN_USER=admin